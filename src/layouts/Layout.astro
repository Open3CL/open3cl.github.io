---
import '../static/styles/themify-icons.css';
import '../static/styles/materialdesignicons.min.css';
import '../static/styles/swiper-bundle.min.css';
import '../static/styles/tobii.min.css';
import '../static/styles/style.css';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const {
	pageTitle = 'Open3CL - Moteur de calcul 3CL Open Source',
	pageDescription = '',
	pageKeywords = '3cl open source engine moteur calcul méthode'
} = Astro.props;

---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content={pageDescription} />
	<meta name="generator" content={Astro.generator} />
	<meta name="keywords" content={pageKeywords} />
	<!-- Site Title -->
	<title>{pageTitle}</title>

	<!-- Site favicon -->
	<link rel="icon" type="image/svg+xml" href="../../public/favicon.svg" />

</head>
<body class="antialiased text-base font-nunito">

	<Header />
	<slot />
	<Footer />

</body>
</html>