---
import logoRedFroggy from '../assets/users/Redfroggy_Logo_RVB_320x132.png';
import logoKardino from '../assets/users/Kardino_Logo.svg';
---

<!-- Start Client Logo -->
<section class="pt-20 pb-36 bg-white relative">
    <div class="container">
        <div class="grid grid-cols-1">
            <div class="text-center">
                <h2 class="font-bold text-[32px] md:text-[40px] capitalize mb-2 relative z-10"><span
                        class="bg-[#dff1f0] h-[70px] w-[70px] inline-block absolute rounded-full -z-10 -top-[15px]"></span>Rejoignez
                    nous !</h2>
                <p class="text-muted mx-auto text-lg max-w-[600px] mt-6">Venez grossir les rangs des utilisateurs et
                    contributeurs de la librairie Open3CL.</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 bg-custom rounded mt-12 py-10 gap-[30px] items-center">
            <div class="p-5">
                <a href="https://redfroggy.fr" target="_blank"><img src={logoRedFroggy.src} alt="Logo Red Froggy" class="mx-auto block"></a>
            </div>
            <div class="p-5">
                <a href="https://kardino.fr/" target="_blank"><img src={logoKardino.src} alt="Logo Kardino" class="mx-auto block"></a>
            </div>
        </div>
    </div>
</section>
<!-- End Client Logo -->