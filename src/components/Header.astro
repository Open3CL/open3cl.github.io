---
import logo from '../assets/images/logo-open3cl.svg';
---

<header>
    <nav class="navbar navbar-expand-lg navbar-light fixed w-full horizontal-nav">
        <div class="container">
            <div class="flex items-center justify-between">
                <a class="navbar-brand" href="/">
                    <img src={logo.src} class="mr-2 w-[130px]" alt="logo open3CL">
                </a>
                <button class="navbar-toggler hidden text-end mobile-menu-button">
                        <span class="navbar-toggler-icon">
                            <i class="ti-menu icon-align-right"></i>
                        </span>
                </button>
                <div class="navbar-collapse flex-1 mobile-menu hidden min-[991px]:block" id="navbarNav">
                    <ul class="navbar-nav justify-end horizontal-menu">
                        <li class="active">
                            <a href="/"><span>Pourquoi Open3CL ?</span></a>
                        </li>
                        <li class="scroll dropdown group/menu">
                            <a href="" class="dropdown-toggle"><span>Utiliser</span></a>
                            <ul class="dropdown-menu hidden group-hover/menu:block">
                                <li><a href="/">Fonctionnement</a></li>
                                <li><a href="/">Documentation</a></li>
                                <!--<li><div class="h-2 w-2 block"></div></li>-->
                                <li><a href="/">Mise en place</a></li>
                                <li><a href="/">Aller plus loin</a></li>
                            </ul>
                        </li>
                        <li class="scroll dropdown group/menu">
                            <a href="" class="dropdown-toggle"><span>Contribuer</span></a>
                            <ul class="dropdown-menu hidden group-hover/menu:block">
                                <li><a href="/">Comment contribuer ?</a></li>
                                <li><a href="/">Les contributeurs</a></li>
                                <li><a href="/">Nous contacter</a></li>
                            </ul>
                        </li>
                        <li class="scroll dropdown group/menu">
                            <a href="" class="dropdown-toggle"><span>Actualités</span></a>
                            <ul class="dropdown-menu hidden group-hover/menu:block">
                                <li><a href="/">Articles</a></li>
                                <li><a href="/">Feuille de route</a></li>
                                <li><a href="/">L'association Open3CL</a></li>
                            </ul>
                        </li>
                        <a href="https://github.com/Open3CL" target="_blank" class="btn btn-sm btn-custom navbar-btn btn-rounded">
                            <i class="mdi mdi-github text-white text-lg"></i>
                            GitHub
                        </a>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
</header>